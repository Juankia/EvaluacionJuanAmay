rectangle "Dispositivos del cliente\n<size:15>[Deployment Node: Navegador, Android, iOS]</size>" <<DeploymentNode-RWxlbWVudA==>> as Referencia.Dispositivosdelcliente {
  rectangle "Navegador web\n<size:15>[Deployment Node: Navegador moderno]</size>" <<DeploymentNode-RWxlbWVudA==>> as Referencia.Dispositivosdelcliente.Navegadorweb {
    rectangle "==SPA web\n<size:15>[Contenedor: React + TypeScript]</size>\n\nAplicación de página única para la banca web: consultas y transferencias. No conserva tokens OAuth en el navegador (sesión gestionada por el BFF)." <<Element-RWxlbWVudCxDb250YWluZXIsTmF2ZWdhZG9y>> as Referencia.Dispositivosdelcliente.Navegadorweb.SPAweb_1
  }

  rectangle "Teléfono inteligente\n<size:15>[Deployment Node: Android / iOS]</size>" <<DeploymentNode-RWxlbWVudA==>> as Referencia.Dispositivosdelcliente.Teléfonointeligente {
    rectangle "==Aplicación móvil\n<size:15>[Contenedor: React Native + TypeScript (recomendado, ADR-0018)]</size>\n\nAplicación multiplataforma para la banca móvil y la vinculación digital. Integra el SDK del proveedor KYC/biométrico y la biometría local del dispositivo." <<Element-RWxlbWVudCxDb250YWluZXIsTcOzdmls>> as Referencia.Dispositivosdelcliente.Teléfonointeligente.Aplicaciónmóvil_1
  }

}

rectangle "AWS — región principal\n<size:15>[Deployment Node: Amazon Web Services]</size>" <<DeploymentNode-RWxlbWVudA==>> as Referencia.AWSregiónprincipal {
  rectangle "Borde\n<size:15>[Deployment Node: AWS edge]</size>" <<DeploymentNode-RWxlbWVudA==>> as Referencia.AWSregiónprincipal.Borde {
    rectangle "==CDN, WAF y anti-DDoS\n<size:15>[Infrastructure Node: CloudFront, AWS WAF, AWS Shield]</size>\n\nEntrega la SPA; filtra el tráfico con reglas gestionadas y límites de tasa" <<Element-RWxlbWVudCxJbmZyYXN0cnVjdHVyZSBOb2Rl>> as Referencia.AWSregiónprincipal.Borde.CDNWAFyantiDDoS
  }

  rectangle "VPC de la plataforma\n<size:15>[Deployment Node: Amazon VPC]</size>" <<DeploymentNode-RWxlbWVudA==>> as Referencia.AWSregiónprincipal.VPCdelaplataforma {
    rectangle "Entrada\n<size:15>[Deployment Node: API Gateway gestionado o Kong (DD-15)]</size>" <<DeploymentNode-RWxlbWVudA==>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Entrada {
      rectangle "==API Gateway\n<size:15>[Contenedor: Producto de API Gateway gestionado (por seleccionar, DD-15)]</size>\n\nPunto único de entrada: enrutamiento, validación de tokens, limitación de tasa, correlación y políticas de seguridad de borde. Sin lógica de negocio ni estado financiero (ADR-0002)." <<Element-RWxlbWVudCxDb250YWluZXI=>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Entrada.APIGateway_1
    }

    rectangle "Cómputo de aplicaciones (x3)\n<size:15>[Deployment Node: Amazon EKS o ECS/Fargate (por decidir)]</size>" <<DeploymentNode-RWxlbWVudA==>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Cómputodeaplicaciones {
      rectangle "==BFF de canales digitales\n<size:15>[Contenedor: Java 21 / Quarkus (provisional, ADR-0017)]</size>\n\nBackend for Frontend compartido por web y móvil: gestor de tokens de la SPA (sesión en el almacén de sesiones, ADR-0019), composición de lecturas y adaptación por canal. Proceso sin estado; no posee invariantes financieros (ADR-0014)." <<Element-RWxlbWVudCxDb250YWluZXI=>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Cómputodeaplicaciones.BFFdecanalesdigitales_1
      rectangle "==Proveedor de identidad (IdP)\n<size:15>[Contenedor: Producto OIDC; candidato provisional: Keycloak (ADR-0013)]</size>\n\nServidor de autorización OAuth 2.0 / OpenID Connect para clientes: autenticación, MFA, sesiones y emisión de tokens. Interno a la plataforma (ADR-0013)." <<Element-RWxlbWVudCxDb250YWluZXI=>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Cómputodeaplicaciones.ProveedordeidentidadIdP_1
      rectangle "==Servicio de consultas\n<size:15>[Contenedor: Java 21 / Quarkus (provisional, ADR-0017)]</size>\n\nDatos del cliente, cuentas, saldos y movimientos. Contiene las ACL de clientes (lectura), de movimientos y del Sistema Complementario como módulos internos. Aplica Cache-Aside (ADR-0004) y cuotas CL-3/CL-4 (ADR-0011)." <<Element-RWxlbWVudCxDb250YWluZXI=>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Cómputodeaplicaciones.Serviciodeconsultas_1
      rectangle "==Servicio de vinculación digital\n<size:15>[Contenedor: Java 21 / Quarkus (provisional, ADR-0017)]</size>\n\nMáquina de estados de vinculación (E1 a E6, ADR-0009): verificación de identidad, identificación y alta del cliente, autorización de la vinculación y activación del acceso digital. Contiene la ACL de alta y búsqueda de clientes." <<Element-RWxlbWVudCxDb250YWluZXI=>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Cómputodeaplicaciones.Serviciodevinculacióndigital_1
      rectangle "==Servicio de transferencias\n<size:15>[Contenedor: Java 21 / Quarkus (provisional, ADR-0017)]</size>\n\nContrato de idempotencia (ADR-0006) y orquestador durable de transferencias (ADR-0005): titularidad cercada, permiso de envío único, conciliación y efecto tardío. Contiene la ACL de transferencias. PROVISIONAL: CF-01/CF-02 sin verificación independiente." <<Element-RWxlbWVudCxDb250YWluZXIsUHJvdmlzaW9uYWw=>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Cómputodeaplicaciones.Serviciodetransferencias_1
      rectangle "==Servicio de notificaciones\n<size:15>[Contenedor: Java 21 / Quarkus (provisional, ADR-0017)]</size>\n\nConvierte eventos confirmados en notificaciones push, SMS y correo; deduplicación, reintentos y canal alternativo. Una falla de notificación nunca revierte una operación." <<Element-RWxlbWVudCxDb250YWluZXI=>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Cómputodeaplicaciones.Serviciodenotificaciones_1
      rectangle "==Servicio de auditoría\n<size:15>[Contenedor: Java 21 / Quarkus (provisional, ADR-0017)]</size>\n\nRecibe los eventos de auditoría de todos los contenedores y los registra en un almacén de solo anexión con encadenamiento de hashes (R5)." <<Element-RWxlbWVudCxDb250YWluZXI=>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Cómputodeaplicaciones.Serviciodeauditoría_1
    }

    rectangle "Zona de administración\n<size:15>[Deployment Node: Amazon EKS o ECS/Fargate]</size>" <<DeploymentNode-RWxlbWVudA==>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Zonadeadministración {
      rectangle "==Consola de operaciones\n<size:15>[Contenedor: Aplicación web interna (por definir)]</size>\n\nResolución de REQUIRES_RECONCILIATION y MANUAL_REVIEW con cuatro ojos, cierre excepcional y consulta de auditoría. PROVISIONAL: puede sustituirse por un sistema administrativo existente (DD-18)." <<Element-RWxlbWVudCxDb250YWluZXIsUHJvdmlzaW9uYWw=>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Zonadeadministración.Consoladeoperaciones_1
    }

    rectangle "Datos gestionados\n<size:15>[Deployment Node: Multizona]</size>" <<DeploymentNode-RWxlbWVudA==>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Datosgestionados {
      rectangle "PostgreSQL por servicio\n<size:15>[Deployment Node: Amazon RDS / Aurora PostgreSQL Multi-AZ]</size>" <<DeploymentNode-RWxlbWVudA==>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Datosgestionados.PostgreSQLporservicio {
        database "==BD del IdP\n<size:15>[Contenedor: PostgreSQL (ADR-0016)]</size>\n\nCuentas digitales, credenciales (con hash), factores y sesiones del IdP." <<Element-RWxlbWVudCxDb250YWluZXIsQWxtYWPDqW4gZGUgZGF0b3M=>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Datosgestionados.PostgreSQLporservicio.BDdelIdP_1
        database "==BD de consultas\n<size:15>[Contenedor: PostgreSQL (ADR-0016)]</size>\n\nOutbox de eventos de auditoría de consultas y metadatos locales. No almacena saldos ni movimientos como fuente." <<Element-RWxlbWVudCxDb250YWluZXIsQWxtYWPDqW4gZGUgZGF0b3M=>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Datosgestionados.PostgreSQLporservicio.BDdeconsultas_1
        database "==BD de vinculación\n<size:15>[Contenedor: PostgreSQL (ADR-0016)]</size>\n\nEstado durable de las solicitudes de vinculación, claves de idempotencia, evidencia de creación y outbox. Sujeta a PT-01 a PT-03 y PT-07 por el alta de clientes (ADR-0016)." <<Element-RWxlbWVudCxDb250YWluZXIsQWxtYWPDqW4gZGUgZGF0b3M=>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Datosgestionados.PostgreSQLporservicio.BDdevinculación_1
        database "==BD transaccional de transferencias\n<size:15>[Contenedor: PostgreSQL (ADR-0016)]</size>\n\nIntenciones, huellas, estado de las operaciones, titularidad y tokens, evidencia huérfana, casos de conciliación y outbox. Requisitos: escritor único, RPO 0 de las escrituras confirmadas y cuarentena tras restauración (ADR-0016)." <<Element-RWxlbWVudCxDb250YWluZXIsQWxtYWPDqW4gZGUgZGF0b3MsUHJvdmlzaW9uYWw=>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Datosgestionados.PostgreSQLporservicio.BDtransaccionaldetransferencias_1
        database "==BD de notificaciones\n<size:15>[Contenedor: PostgreSQL (ADR-0016)]</size>\n\nRegistro de eventos recibidos, intentos de entrega y preferencias de canal." <<Element-RWxlbWVudCxDb250YWluZXIsQWxtYWPDqW4gZGUgZGF0b3M=>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Datosgestionados.PostgreSQLporservicio.BDdenotificaciones_1
        database "==Almacén de auditoría\n<size:15>[Contenedor: PostgreSQL + archivo inmutable en almacenamiento de objetos (ADR-0016)]</size>\n\nRegistro de auditoría de solo anexión, con evidencia de integridad y archivo inmutable según la retención acordada." <<Element-RWxlbWVudCxDb250YWluZXIsQWxtYWPDqW4gZGUgZGF0b3M=>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Datosgestionados.PostgreSQLporservicio.Almacéndeauditoría_1
      }

      rectangle "Caché y sesiones\n<size:15>[Deployment Node: Amazon ElastiCache (compatible con Redis)]</size>" <<DeploymentNode-RWxlbWVudA==>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Datosgestionados.Cachéysesiones {
        database "==Caché de consultas\n<size:15>[Contenedor: Caché distribuida compatible con Redis (provisional, DD-07)]</size>\n\nDatos derivados del Core y del Sistema Complementario según la matriz de cacheabilidad. Nunca autoritativa." <<Element-RWxlbWVudCxDb250YWluZXIsQWxtYWPDqW4gZGUgZGF0b3M=>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Datosgestionados.Cachéysesiones.Cachédeconsultas_1
        database "==Almacén de sesiones del BFF\n<size:15>[Contenedor: Almacén clave-valor en memoria con alta disponibilidad (producto con DD-15)]</size>\n\nSesiones web y tokens de la SPA cifrados, índice de sujeto a sesiones y claves de intenciones pendientes generadas por la SPA (ADR-0019)." <<Element-RWxlbWVudCxDb250YWluZXIsQWxtYWPDqW4gZGUgZGF0b3M=>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Datosgestionados.Cachéysesiones.AlmacéndesesionesdelBFF_1
      }

      rectangle "Broker\n<size:15>[Deployment Node: Amazon MQ for RabbitMQ]</size>" <<DeploymentNode-RWxlbWVudA==>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Datosgestionados.Broker {
        queue "==Broker de mensajería\n<size:15>[Contenedor: Broker gestionado de colas y tópicos (por seleccionar, DD-15)]</size>\n\nDistribuye los eventos publicados desde los outbox: entrega al menos una vez, tópicos con suscripciones, colas de mensajes fallidos (ADR-0015)." <<Element-RWxlbWVudCxDb250YWluZXIsTWVuc2FqZXLDrWE=>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Datosgestionados.Broker.Brokerdemensajería_1
      }

      rectangle "Diario de despacho (BLOQUEADO)\n<size:15>[Deployment Node: Por seleccionar]</size>" <<DeploymentNode-RWxlbWVudA==>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Datosgestionados.DiariodedespachoBLOQUEADO {
        database "==Diario de autorización de despacho\n<size:15>[Contenedor: Almacén linealizable con quórum entre dominios de falla (capacidad por seleccionar, DD-23)]</size>\n\nRegistro independiente, de solo anexión y con confirmación por quórum en al menos tres dominios de falla. Ningún tramo se despacha sin su entrada (INV-DR-1). Mantiene la época regional (ADR-0021). PROVISIONAL." <<Element-RWxlbWVudCxDb250YWluZXIsQWxtYWPDqW4gZGUgZGF0b3MsUHJvdmlzaW9uYWw=>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Datosgestionados.DiariodedespachoBLOQUEADO.Diariodeautorizacióndedespacho_1
      }

    }

    rectangle "Seguridad y operación\n<size:15>[Deployment Node: Servicios gestionados]</size>" <<DeploymentNode-RWxlbWVudA==>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Seguridadyoperación {
      rectangle "==Claves y secretos\n<size:15>[Infrastructure Node: AWS KMS, CloudHSM (candidato), Secrets Manager]</size>\n\nCifrado, firma de afirmaciones (PF4-05) y secretos de servicio; rotación" <<Element-RWxlbWVudCxJbmZyYXN0cnVjdHVyZSBOb2Rl>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Seguridadyoperación.Clavesysecretos
      rectangle "==Observabilidad\n<size:15>[Infrastructure Node: OpenTelemetry, CloudWatch]</size>\n\nTrazas, métricas y registros con correlación, sin datos sensibles" <<Element-RWxlbWVudCxJbmZyYXN0cnVjdHVyZSBOb2Rl>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Seguridadyoperación.Observabilidad
      rectangle "==Telemetría de seguridad\n<size:15>[Infrastructure Node: CloudTrail, GuardDuty, Security Hub]</size>\n\nRegistro de la API de control y detección de amenazas; envío al SIEM institucional si existe (Q-13)" <<Element-RWxlbWVudCxJbmZyYXN0cnVjdHVyZSBOb2Rl>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Seguridadyoperación.Telemetríadeseguridad
      rectangle "==Respaldos\n<size:15>[Infrastructure Node: AWS Backup]</size>\n\nCopias cifradas en una cuenta aislada, con bloqueo de retención" <<Element-RWxlbWVudCxJbmZyYXN0cnVjdHVyZSBOb2Rl>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Seguridadyoperación.Respaldos
      rectangle "==Archivo inmutable de auditoría\n<size:15>[Infrastructure Node: Amazon S3 Object Lock]</size>\n\nWORM; retención por acordar (Q-19)" <<Element-RWxlbWVudCxJbmZyYXN0cnVjdHVyZSBOb2Rl>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.Seguridadyoperación.Archivoinmutabledeauditoría
    }

    rectangle "==Conectividad privada hacia el Core\n<size:15>[Infrastructure Node: AWS Direct Connect o VPN IPsec (por decidir)]</size>\n\nSin tránsito por Internet. Topología y ubicación del Core por confirmar (Q-20)" <<Element-RWxlbWVudCxJbmZyYXN0cnVjdHVyZSBOb2Rl>> as Referencia.AWSregiónprincipal.VPCdelaplataforma.ConectividadprivadahaciaelCore
  }

}

rectangle "AWS — región secundaria (DR)\n<size:15>[Deployment Node: Amazon Web Services]</size>" <<DeploymentNode-RWxlbWVudA==>> as Referencia.AWSregiónsecundariaDR {
  rectangle "==Réplicas y respaldos entre regiones\n<size:15>[Infrastructure Node: RDS cross-region, AWS Backup]</size>\n\nRéplica asíncrona de PostgreSQL y copias de respaldo; RPO mayor que 0" <<Element-RWxlbWVudCxJbmZyYXN0cnVjdHVyZSBOb2Rl>> as Referencia.AWSregiónsecundariaDR.Réplicasyrespaldosentreregiones
  rectangle "==Cómputo en espera\n<size:15>[Infrastructure Node: EKS o ECS/Fargate]</size>\n\nInfraestructura como código e imágenes replicadas; capacidad mínima hasta la conmutación" <<Element-RWxlbWVudCxJbmZyYXN0cnVjdHVyZSBOb2Rl>> as Referencia.AWSregiónsecundariaDR.Cómputoenespera
  rectangle "==Réplica del archivo de auditoría\n<size:15>[Infrastructure Node: S3 Cross-Region Replication]</size>" <<Element-RWxlbWVudCxJbmZyYXN0cnVjdHVyZSBOb2Rl>> as Referencia.AWSregiónsecundariaDR.Réplicadelarchivodeauditoría
}

rectangle "Infraestructura de la institución\n<size:15>[Deployment Node: Por confirmar]</size>" <<DeploymentNode-RWxlbWVudA==>> as Referencia.Infraestructuradelainstitución {
  rectangle "==Core Bancario\n<size:15>[Sistema de software]</size>\n\nSistema existente y autoritativo para los datos maestros del cliente, productos, cuentas, movimientos y transacciones bancarias (S1, S2, ADR-0009)." <<Element-RWxlbWVudCxTaXN0ZW1hIGV4aXN0ZW50ZQ==>> as Referencia.Infraestructuradelainstitución.CoreBancario_1
  rectangle "==Sistema Complementario de Clientes\n<size:15>[Sistema de software]</size>\n\nSistema existente con información extendida del cliente. No es autoritativo para la creación ni para la identidad del cliente (S5, ADR-0009)." <<Element-RWxlbWVudCxTaXN0ZW1hIGV4aXN0ZW50ZQ==>> as Referencia.Infraestructuradelainstitución.SistemaComplementariodeClientes_1
