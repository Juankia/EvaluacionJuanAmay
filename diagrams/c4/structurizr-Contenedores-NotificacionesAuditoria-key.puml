@startuml

set separator none
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Container
  .Element-RWxlbWVudCxDb250YWluZXI= {
    BackgroundColor: #438dd5;
    LineColor: #2e6295;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 22;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Container,Almacén de datos
  .Element-RWxlbWVudCxDb250YWluZXIsQWxtYWPDqW4gZGUgZGF0b3M= {
    BackgroundColor: #2f6fa7;
    LineColor: #204d74;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 22;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Container,Mensajería
  .Element-RWxlbWVudCxDb250YWluZXIsTWVuc2FqZXLDrWE= {
    BackgroundColor: #2f6fa7;
    LineColor: #204d74;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 22;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Container,Provisional
  .Element-RWxlbWVudCxDb250YWluZXIsUHJvdmlzaW9uYWw= {
    BackgroundColor: #438dd5;
    LineColor: #b45f06;
    LineStyle: 30-30;
    LineThickness: 6;
    FontColor: #ffffff;
    FontSize: 22;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Person
  .Element-RWxlbWVudCxQZXJzb24= {
    BackgroundColor: #08427b;
    LineColor: #052e56;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 22;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Proveedor tercero
  .Element-RWxlbWVudCxQcm92ZWVkb3IgdGVyY2Vybw== {
    BackgroundColor: #8a8a8a;
    LineColor: #606060;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 22;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 0;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 20;
    MaximumWidth: 200;
  }
  // Relationship,Supuesta
  .Relationship-UmVsYXRpb25zaGlwLFN1cHVlc3Rh {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 20;
    MaximumWidth: 200;
  }
  // Plataforma de Banca Digital
  .Boundary-UGxhdGFmb3JtYSBkZSBCYW5jYSBEaWdpdGFs {
    BackgroundColor: #ffffff;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 22;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // transparent element for relationships in legend
  .Element-Transparent {
    BackgroundColor: transparent;
    LineColor: transparent;
    FontColor: transparent;
  }
</style>

rectangle "==Container" <<Element-RWxlbWVudCxDb250YWluZXI=>>

database "==Container, Almacén de datos" <<Element-RWxlbWVudCxDb250YWluZXIsQWxtYWPDqW4gZGUgZGF0b3M=>>

queue "==Container, Mensajería" <<Element-RWxlbWVudCxDb250YWluZXIsTWVuc2FqZXLDrWE=>>

rectangle "==Container, Provisional" <<Element-RWxlbWVudCxDb250YWluZXIsUHJvdmlzaW9uYWw=>>

person "==Person" <<Element-RWxlbWVudCxQZXJzb24=>>

rectangle "==Proveedor tercero" <<Element-RWxlbWVudCxQcm92ZWVkb3IgdGVyY2Vybw==>>

rectangle "." <<.Element-Transparent>> as 1
1 --> 1 <<Relationship-UmVsYXRpb25zaGlw>> : "Relationship"

rectangle "." <<.Element-Transparent>> as 2
2 --> 2 <<Relationship-UmVsYXRpb25zaGlwLFN1cHVlc3Rh>> : "Supuesta"

@enduml