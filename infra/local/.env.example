# Local environment for the prod profile. Copy to infra/local/.env (not versioned) and replace
# every value. SYNTHETIC DATA ONLY: never point these at the Core or at institution systems.

# Message broker
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=change-me
RABBITMQ_PASSWORD=change-me

# Digital linking service
LINKING_DB_URL=jdbc:postgresql://localhost:5432/linking
LINKING_DB_USER=linking
LINKING_DB_PASSWORD=change-me
# At least 32 characters. Production custody (HSM or KMS) is pending (PF4-05).
LINKING_DIGEST_KEY=change-me-with-at-least-32-random-characters

# Notifications service
NOTIFICATIONS_DB_URL=jdbc:postgresql://localhost:5433/notifications
NOTIFICATIONS_DB_USER=notifications
NOTIFICATIONS_DB_PASSWORD=change-me

# Audit service
AUDIT_DB_URL=jdbc:postgresql://localhost:5434/audit
AUDIT_DB_USER=audit
AUDIT_DB_PASSWORD=change-me
# Corporate IdP is not available locally (docs/implementacion/05)
AUDIT_JWT_ISSUER=https://corporate-idp.invalid
AUDIT_JWT_PUBLIC_KEY_LOCATION=file:///path/to/public.pem
